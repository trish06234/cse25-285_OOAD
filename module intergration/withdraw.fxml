<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="220.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <Label layoutX="130.0" layoutY="25.0" style="-fx-font-weight: bold; -fx-font-size: 14px;" text="WITHDRAW FUNDS" />
      <Label layoutX="50.0" layoutY="80.0" text="Amount (P):" />
      <TextField fx:id="withdrawAmountField" layoutX="140.0" layoutY="76.0" prefWidth="200.0" promptText="Enter withdrawal amount" />
      
      <Button layoutX="110.0" layoutY="145.0" mnemonicParsing="false" onAction="#processWithdraw" prefWidth="80.0" text="WITHDRAW" />
      <Button layoutX="215.0" layoutY="145.0" mnemonicParsing="false" onAction="#cancelTransaction" prefWidth="80.0" text="CANCEL" />
   </children>
</AnchorPane>