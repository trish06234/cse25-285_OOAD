<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml" prefWidth="500.0" prefHeight="300.0">

    <children>

        <Label layoutX="180.0" layoutY="40.0" text="Withdraw Funds" style="-fx-font-size:20px; -fx-font-weight:bold;" />

        <Label layoutX="80.0" layoutY="120.0" text="Amount:" />

        <TextField fx:id="withdrawAmountField  layoutX="180.0"  layoutY="115.0"  prefWidth="180.0" />

        <Button layoutX="150.0"  layoutY="220.0"  text="Withdraw" onAction="#processWithdraw" />

        <Button layoutX="260.0"  layoutY="220.0" text="Cancel" onAction="#cancelTransaction" />

    </children>

</AnchorPane>
