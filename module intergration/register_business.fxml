<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import java.lang.String?>

<AnchorPane prefHeight="540.0" prefWidth="550.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <Label layoutX="175.0" layoutY="14.0" text="APPLE BANK - BUSINESS REGISTRATION" style="-fx-font-weight: bold;" />

      <Label layoutX="58.0" layoutY="45.0" text="COMPANY REGISTRATION NO." />
      <Label layoutX="60.0" layoutY="75.0" text="COMPANY NAME" />
      <Label layoutX="60.0" layoutY="105.0" text="INCORPORATION DATE" />
      <Label layoutX="58.0" layoutY="135.0" text="PHYSICAL ADDRESS" />
      <Label layoutX="59.0" layoutY="165.0" text="EMAIL ADDRESS" />
      <Label layoutX="57.0" layoutY="195.0" text="POSTAL ADDRESS" />
      <Label layoutX="58.0" layoutY="225.0" text="ANNUAL TURNOVER" />
      <Label layoutX="58.0" layoutY="255.0" text="SHAREHOLDER DETAILS" />
      <Label layoutX="59.0" layoutY="315.0" text="ACCOUNT TYPE" />
      <Label layoutX="59.0" layoutY="345.0" text="CELLPHONE NUMBER" />
      <Label layoutX="58.0" layoutY="375.0" text="COMPANY PROFILE" />

      <TextField fx:id="regIdField" layoutX="260.0" layoutY="41.0" prefWidth="240.0" promptText="Registration No. / Passport" />
      <TextField fx:id="regNameField" layoutX="260.0" layoutY="71.0" prefWidth="240.0" promptText="Company Name" />
      <TextField fx:id="regDobField" layoutX="260.0" layoutY="101.0" prefWidth="240.0" promptText="YYYY-MM-DD" />
      <TextField fx:id="regAddressField" layoutX="260.0" layoutY="131.0" prefWidth="240.0" promptText="Physical Address" />
      <TextField fx:id="regEmailField" layoutX="260.0" layoutY="161.0" prefWidth="240.0" promptText="Email Address" />
      <TextField fx:id="regPostalField" layoutX="260.0" layoutY="191.0" prefWidth="240.0" promptText="Postal Address" />
      <TextField fx:id="regIncomeField" layoutX="260.0" layoutY="221.0" prefWidth="240.0" promptText="Annual Turnover" />
      
      <!-- Shareholder personal details (ID/Passport, Names, DOB, Address, etc.) -->
      <TextField fx:id="regEmploymentField" layoutX="260.0" layoutY="251.0" prefWidth="240.0" promptText="Shareholder Info (ID, Names, DOB, Contact)" />

      <!-- Account Type Options -->
      <ComboBox fx:id="regAccountTypeCombo" layoutX="260.0" layoutY="311.0" prefWidth="240.0" promptText="Select Account Type">
          <items>
              <FXCollections fx:factory="observableArrayList">
                  <String fx:value="Savings Account" />
                  <String fx:value="Investment Account" />
                  <String fx:value="Cheque Account" />
              </FXCollections>
          </items>
      </ComboBox>

      <TextField fx:id="regPhoneField" layoutX="260.0" layoutY="341.0" prefWidth="240.0" promptText="Cellphone Number" />
      
      <!-- Multi-line Company Profile Description -->
      <TextArea fx:id="regCompanyProfileArea" layoutX="260.0" layoutY="375.0" prefWidth="240.0" prefHeight="80.0" promptText="Briefly describe the company profile..." />
      
      <Button layoutX="180.0" layoutY="480.0" mnemonicParsing="false" onAction="#continueAction" text="CONTINUE" />
      <Button layoutX="300.0" layoutY="480.0" mnemonicParsing="false" onAction="#cancelAction" text="CANCEL" />
   </children>
</AnchorPane>