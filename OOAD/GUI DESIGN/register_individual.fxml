<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import java.lang.String?>

<AnchorPane prefHeight="420.0" prefWidth="550.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <Label fx:id="regTitleLabel" layoutX="170.0" layoutY="14.0" text="PERSONAL REGISTRATION">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Label>

      <Label fx:id="regIdLabel" layoutX="58.0" layoutY="45.0" text="ID NUMBER" />
      <Label fx:id="regNameLabel" layoutX="60.0" layoutY="75.0" text="FULLNAME" />
      <Label fx:id="regDobLabel" layoutX="60.0" layoutY="105.0" text="DATE OF BIRTH" />
      <Label layoutX="58.0" layoutY="135.0" text="PHYSICAL ADDRESS" />
      <Label layoutX="59.0" layoutY="165.0" text="EMAIL ADDRESS" />
      <Label layoutX="57.0" layoutY="195.0" text="POSTAL ADDRESS" />
      <Label fx:id="regIncomeLabel" layoutX="58.0" layoutY="225.0" text="SOURCE OF INCOME" />
      <Label fx:id="regEmploymentLabel" layoutX="58.0" layoutY="255.0" text="EMPLOYMENT DETAILS" />
      <Label layoutX="59.0" layoutY="285.0" text="ACCOUNT TYPE" />
      <Label layoutX="59.0" layoutY="315.0" text="CELLPHONE NUMBER" />
      
      <TextField fx:id="regIdField" layoutX="260.0" layoutY="41.0" prefWidth="240.0" promptText="Enter ID / Passport Number" />
      <TextField fx:id="regNameField" layoutX="260.0" layoutY="71.0" prefWidth="240.0" promptText="Enter Full Name" />
      <TextField fx:id="regDobField" layoutX="260.0" layoutY="101.0" prefWidth="240.0" promptText="YYYY-MM-DD" />
      <TextField fx:id="regAddressField" layoutX="260.0" layoutY="131.0" prefWidth="240.0" promptText="Physical Address" />
      <TextField fx:id="regEmailField" layoutX="260.0" layoutY="161.0" prefWidth="240.0" promptText="Email Address" />
      <TextField fx:id="regPostalField" layoutX="260.0" layoutY="191.0" prefWidth="240.0" promptText="Postal Address" />
      <TextField fx:id="regIncomeField" layoutX="260.0" layoutY="221.0" prefWidth="240.0" promptText="Source of Income" />
      <TextField fx:id="regEmploymentField" layoutX="260.0" layoutY="251.0" prefWidth="240.0" promptText="Employment Details" />
      
      <ComboBox fx:id="regAccountTypeCombo" layoutX="260.0" layoutY="281.0" prefWidth="240.0" promptText="Select Account Type">
          <items>
              <FXCollections fx:factory="observableArrayList">
                  <String fx:value="Savings Account" />
                  <String fx:value="Investment Account" />
                  <String fx:value="Cheque Account" />
              </FXCollections>
          </items>
      </ComboBox>

      <TextField fx:id="regPhoneField" layoutX="260.0" layoutY="311.0" prefWidth="240.0" promptText="Cellphone Number" />
      
      <Button layoutX="180.0" layoutY="365.0" mnemonicParsing="false" onAction="#continueAction" prefWidth="80.0" text="CONTINUE" />
      <Button layoutX="290.0" layoutY="365.0" mnemonicParsing="false" onAction="#cancelAction" prefWidth="80.0" text="CANCEL" />
   </children>
</AnchorPane>