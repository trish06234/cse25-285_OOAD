<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="250.0" prefWidth="350.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <Label layoutX="107.0" layoutY="20.0" text="APPLE BANK LOGIN">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Label>
      
      <Label layoutX="40.0" layoutY="70.0" text="Account Number:" />
      <Label layoutX="40.0" layoutY="110.0" text="Password:" />
      
      <TextField fx:id="accountNumberField" layoutX="160.0" layoutY="66.0" prefWidth="150.0" promptText="Account Number" />
      <PasswordField fx:id="passwordField" layoutX="160.0" layoutY="106.0" prefWidth="150.0" promptText="Password" />
      
      <Button layoutX="40.0" layoutY="170.0" mnemonicParsing="false" onAction="#submitAction" prefWidth="80.0" text="LOGIN" />
      <Button fx:id="resetButton" layoutX="135.0" layoutY="170.0" mnemonicParsing="false" onAction="#resetAction" prefWidth="80.0" text="RESET" />
      <Button layoutX="230.0" layoutY="170.0" mnemonicParsing="false" onAction="#cancelAction" prefWidth="80.0" text="CANCEL" />
   </children>
</AnchorPane>