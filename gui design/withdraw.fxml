<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="200.0" prefWidth="300.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <Label layoutX="88.0" layoutY="20.0" text="WITHDRAW FUNDS">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Label>
      
      <Label layoutX="30.0" layoutY="70.0" text="Amount (P):" />
      <TextField fx:id="withdrawAmountField" layoutX="110.0" layoutY="66.0" prefWidth="150.0" promptText="0.00" />
      
      <Button layoutX="50.0" layoutY="130.0" mnemonicParsing="false" onAction="#processWithdraw" prefWidth="90.0" text="WITHDRAW" />
      <Button layoutX="160.0" layoutY="130.0" mnemonicParsing="false" onAction="#cancelTransaction" prefWidth="90.0" text="CANCEL" />
   </children>
</AnchorPane>