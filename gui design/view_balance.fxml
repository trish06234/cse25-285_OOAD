<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="180.0" prefWidth="300.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <Label layoutX="92.0" layoutY="20.0" text="ACCOUNT BALANCE">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Label>
      
      <Label fx:id="balanceDisplayLabel" alignment="CENTER" layoutX="20.0" layoutY="65.0" prefWidth="260.0" text="Current Balance: P 0.00">
         <font>
            <Font size="16.0" />
         </font>
      </Label>
      
      <Button layoutX="105.0" layoutY="120.0" mnemonicParsing="false" onAction="#cancelTransaction" prefWidth="90.0" text="BACK" />
   </children>
</AnchorPane>