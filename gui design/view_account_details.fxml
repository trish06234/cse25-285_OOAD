<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="480.0" prefWidth="420.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <Label layoutX="143.0" layoutY="20.0" text="ACCOUNT DETAILS">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Label>
      
      <Label fx:id="detailProfileTypeLabel" layoutX="40.0" layoutY="60.0" text="Account Category: " />
      <Label fx:id="detailIdLabel" layoutX="40.0" layoutY="90.0" text="ID Number / Registration: " />
      <Label fx:id="detailNameLabel" layoutX="40.0" layoutY="120.0" text="Full Name / Company Name: " />
      <Label fx:id="detailDobLabel" layoutX="40.0" layoutY="150.0" text="Date of Birth / Incorporation: " />
      <Label fx:id="detailAddressLabel" layoutX="40.0" layoutY="180.0" text="Physical Address: " />
      <Label fx:id="detailEmailLabel" layoutX="40.0" layoutY="210.0" text="Email Address: " />
      <Label fx:id="detailPostalLabel" layoutX="40.0" layoutY="240.0" text="Postal Address: " />
      <Label fx:id="detailIncomeLabel" layoutX="40.0" layoutY="270.0" text="Source of Income / Turnover: " />
      <Label fx:id="detailEmploymentLabel" layoutX="40.0" layoutY="300.0" text="Employment / Shareholder Details: " />
      <Label fx:id="detailAccountTypeLabel" layoutX="40.0" layoutY="330.0" text="Account Type: " />
      <Label fx:id="detailPhoneLabel" layoutX="40.0" layoutY="360.0" text="Cellphone Number: " />

      <Button layoutX="165.0" layoutY="415.0" mnemonicParsing="false" onAction="#cancelTransaction" prefWidth="90.0" text="BACK" />
   </children>
</AnchorPane>